NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://okf_user:okf_password@localhost:5432/okf_rag?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=super-secret-jwt-key-production-change-me-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-production-32-chars
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Storage (local or s3)
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=okf-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STORAGE_LOCAL_PATH=./uploads

# AI Providers
LLM_PROVIDER=openai
LLM_API_KEY=mock-or-real-openai-key
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# OKF Configuration
OKF_BINARY_PATH=okf
OKF_OUTPUT_DIR=./knowledge/okf

# RAG & Retrieval Config
VECTOR_SEARCH_TOP_K=30
FULLTEXT_SEARCH_TOP_K=30
FUSION_TOP_K=40
RERANK_TOP_K=20
FINAL_CONTEXT_TOP_K=8
MIN_RELEVANCE_SCORE=0.35

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
